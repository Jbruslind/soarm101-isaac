# =============================================================================
# Copy to docker/.env and edit for this machine (docker/.env is gitignored).
# Local Stack Configuration
# =============================================================================

# GPU device index (for multi-GPU systems)
NVIDIA_VISIBLE_DEVICES=0

# OpenPi inference endpoint
# Mode A (local):  OPENPI_HOST=openpi-server  OPENPI_PORT=8000
# Mode B (remote): OPENPI_HOST=gpu-server.example.com  OPENPI_PORT=8443
OPENPI_HOST=openpi-server
OPENPI_PORT=8000
OPENPI_POLICY_MODE=soarm

# Isaac Sim
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y
ISAAC_SIM_HEADLESS=1

# ROS2
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Data paths (relative to docker-compose context)
DATA_DIR=../data
MODELS_DIR=../models
ROBOT_DESC_DIR=../robot_description

# Training defaults (Mode A: local 3080 Ti)
TRAINING_BATCH_SIZE=1
TRAINING_GRAD_ACCUM=8
TRAINING_LORA_RANK=32
TRAINING_QUANTIZE_BASE=true

# Sunshine / Moonlight GUI streaming (docs/SUNSHINE_STREAMING.md)
# X display shared by the sunshine container and Isaac Sim --gui runs
SOARM_DISPLAY=:0
SUNSHINE_NAME=soarm-isaac
SUNSHINE_DISPLAY_WIDTH=1920
SUNSHINE_DISPLAY_HEIGHT=1080
SUNSHINE_DISPLAY_REFRESH=60
# Set both to create/reset the Sunshine web UI login at container start
# (otherwise create it on first visit to https://<host>:47990)
SUNSHINE_USER=
SUNSHINE_PASS=
# Extra web UI origins to trust (comma-separated), e.g. a DNS name or VPN address:
# SUNSHINE_CSRF_ORIGINS=https://gpu.example.lan:47990
SUNSHINE_CSRF_ORIGINS=
# Only these source subnets may reach the Sunshine ports (LAN + VPN). Applied by
# `sudo ./scripts/sunshine-firewall.sh install`; rerun it after changing this.
SUNSHINE_ALLOWED_SUBNETS=192.168.1.0/24,10.0.0.0/24
