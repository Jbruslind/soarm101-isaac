#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "so101_new_calib"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "so101_new_calib"
{
    over "Physics"
    {
        over "gripper" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist_roll" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wrist_flex" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "elbow_flex" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "shoulder_lift" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "shoulder_pan" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

